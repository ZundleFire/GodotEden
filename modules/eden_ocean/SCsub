#!/usr/bin/env python3
Import("env")
Import("env_modules")

env_ocean = env_modules.Clone()


# The shader is embedded so a game needs nothing but the engine binary.
def make_shader_header(target, source, env):
    with open(str(source[0]), "r", encoding="utf-8") as f:
        code = f.read()
    with open(str(target[0]), "w", encoding="utf-8", newline="\n") as f:
        f.write('#pragma once\ninline constexpr const char *EDEN_OCEAN_SHADER_CODE = R"GLSL(\n%s\n)GLSL";\n' % code)


shader_header = env_ocean.CommandNoCache(
    "eden_ocean_shaders.gen.h", "shaders/planet_ocean.gdshader", env.Run(make_shader_header)
)

objects = []
env_ocean.add_source_files(objects, ["register_types.cpp", "eden_planet_ocean.cpp"])
env_ocean.Depends(objects, shader_header)
env.modules_sources += objects
