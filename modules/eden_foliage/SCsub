#!/usr/bin/env python

Import("env")
Import("env_modules")

import sys

env_eden_foliage = env_modules.Clone()

# EdenFoliage derives from zylann::voxel::VoxelInstancer. Voxel headers change class layouts (and vtables) with these
# defines, so they must match modules/voxel/common.py exactly -- a mismatch silently corrupts virtual dispatch (see
# eden_planet_gen/SCsub for the time it did).
env_eden_foliage.Append(CPPDEFINES=["ZN_GODOT", "MESHOPTIMIZER_ZYLANN_WRAP_LIBRARY_IN_NAMESPACE"])
env_eden_foliage.Append(CPPPATH=["#modules/voxel"])
_smooth = env["voxel_smooth_meshing"]
_modifiers = env["voxel_modifiers"] and _smooth and env["voxel_mesh_sdf"]
for _flag, _on in [
	("VOXEL_ENABLE_SMOOTH_MESHING", _smooth),
	("VOXEL_ENABLE_MODIFIERS", _modifiers),
	("VOXEL_ENABLE_SQLITE", env["voxel_sqlite"]),
	("VOXEL_ENABLE_INSTANCER", env["voxel_instancer"]),
	("VOXEL_ENABLE_GPU", env["voxel_gpu"]),
	("VOXEL_ENABLE_BASIC_GENERATORS", env["voxel_basic_generators"]),
	("VOXEL_ENABLE_MESH_SDF", env["voxel_mesh_sdf"]),
	("VOXEL_ENABLE_VOX", env["voxel_vox"]),
]:
	if _on:
		env_eden_foliage.Append(CPPDEFINES={_flag: 1})

# Embedded plant shaders, generated from shaders/* at build time (see gen_foliage_shaders.py)
sys.path.insert(0, Dir(".").srcnode().abspath)
import gen_foliage_shaders

shader_header = env_eden_foliage.CommandNoCache(
    "eden_foliage_shaders.gen.h",
    Glob("shaders/*.gdshader") + Glob("shaders/*.gdshaderinc") + ["gen_foliage_shaders.py"],
    env.Run(gen_foliage_shaders.build),
)

module_obj = []
env_eden_foliage.add_source_files(module_obj, "*.cpp")
env_eden_foliage.Depends(module_obj, shader_header)

env.modules_sources += module_obj
